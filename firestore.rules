rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUid(uid) {
      return uid is string && uid.size() >= 1 && uid.size() <= 128 && uid.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailDocId(email) {
      return email is string && email.size() >= 5 && email.size() <= 128 && email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'champ5698@gmail.com';
    }

    function isAuthorizedEditor() {
      return isSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/authorizedEditors/$(request.auth.token.email.lower()))
      );
    }

    function isValidZoneId(zoneId) {
      return zoneId is string && zoneId.size() <= 40 && zoneId in [
        'warehouse-stock',
        'transformer-sales',
        'transformer-docs',
        'transformer-diagram',
        'dashboard',
        'survey',
        'transformer-inventory',
        'gis'
      ];
    }

    function isValidWorkLink(data) {
      return data.keys().hasAll([
          'zoneId',
          'title',
          'description',
          'url',
          'systemType',
          'isPinned',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'zoneId',
          'title',
          'description',
          'url',
          'systemType',
          'isPinned',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidZoneId(data.zoneId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 300
        && data.url is string && data.url.size() >= 8 && data.url.size() <= 500 && data.url.matches('^https?://.+')
        && data.systemType is string && data.systemType.size() >= 1 && data.systemType.size() <= 60
        && data.isPinned is bool
        && isValidUid(data.createdBy)
        && isValidUid(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuthorizedEditor(data, editorEmail) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'addedBy', 'createdAt'])
        && isValidEmailDocId(data.email)
        && data.email == editorEmail
        && isValidUid(data.addedBy)
        && data.createdAt is timestamp;
    }

    // --- Collection: /workLinks/{linkId} ---
    // Publicly viewable & clickable by all visitors; mutations strictly require an allowlisted authorized editor.
    match /workLinks/{linkId} {
      allow get: if isValidId(linkId) && isValidZoneId(existing().zoneId);
      allow list: if isValidZoneId(existing().zoneId);

      allow create: if isAuthorizedEditor()
        && isValidId(linkId)
        && isValidWorkLink(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAuthorizedEditor()
        && isValidId(linkId)
        && isValidWorkLink(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'zoneId', 'title', 'description', 'url', 'systemType', 'isPinned', 'updatedBy', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isPinned', 'updatedBy', 'updatedAt'
          ])
        );

      allow delete: if isAuthorizedEditor() && isValidId(linkId);
    }

    // --- Collection: /authorizedEditors/{editorEmail} ---
    // Users can only check their own authorization doc; only super-admin can list, add, or remove editors.
    match /authorizedEditors/{editorEmail} {
      allow get: if isVerifiedUser()
        && isValidEmailDocId(editorEmail)
        && (isSuperAdmin() || request.auth.token.email.lower() == editorEmail);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && isValidEmailDocId(editorEmail)
        && isValidAuthorizedEditor(incoming(), editorEmail)
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidEmailDocId(editorEmail);
    }
  }
}
