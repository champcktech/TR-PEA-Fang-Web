{
  "entities": {
    "WorkLink": {
      "title": "WorkLink",
      "description": "A work link item assigned to one of the 6 PEA Fang Mini-Map stations",
      "type": "object",
      "properties": {
        "zoneId": {
          "type": "string",
          "enum": [
            "warehouse-stock",
            "transformer-sales",
            "transformer-docs",
            "transformer-diagram",
            "dashboard",
            "survey"
          ],
          "maxLength": 40,
          "description": "Station ID on the 2D Mini-Map"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display title of the work link"
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Short summary description of the work link"
        },
        "url": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https?://.+",
          "description": "Destination HTTP or HTTPS URL"
        },
        "systemType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "System or document category label"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the link is pinned/starred"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the authorized editor who created the link"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the authorized editor who last updated the link"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "zoneId",
        "title",
        "description",
        "url",
        "systemType",
        "isPinned",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuthorizedEditor": {
      "title": "AuthorizedEditor",
      "description": "Allowlisted Google account email authorized to sign in and edit Mini-Map links",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$",
          "description": "Lowercase email address matching the document ID"
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the super-admin who granted access"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when edit access was granted"
        }
      },
      "required": [
        "email",
        "addedBy",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/workLinks/{linkId}": {
      "schema": {
        "$ref": "#/entities/WorkLink"
      },
      "description": "Publicly readable work links for the PEA Fang 2D Mini-Map; mutations restricted strictly to allowlisted authorized editors."
    },
    "/authorizedEditors/{editorEmail}": {
      "schema": {
        "$ref": "#/entities/AuthorizedEditor"
      },
      "description": "Email allowlist documents keyed by lowercase email. Readable only by the super-admin or the matching user checking their own access."
    }
  }
}
